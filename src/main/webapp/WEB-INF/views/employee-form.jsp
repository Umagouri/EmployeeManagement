<head>

</head>
<body>
<h2>Add Employees</h2>
<form action="save" method="post">
<label for="empname">Employee Name</label>
<input type="text" name="empname" placeholder="Enter Employee Name"></input>
<br><br>

<label for="empmail">Employee mail</label>
<input type="text" name="empmail" placeholder="Enter Employee Email"></input>
<br><br>

<label for="empage">Employee Age</label>
<input type="text" name="empage" placeholder="Enter Employee age"></input>
<br><br>

<label for="empsalary">Employee salary</label>
<input type="text" name="empsalary" placeholder="Enter Employee Salary"></input>
<br><br>

<label for="empdept">Employee Department</label>
<input type="text" name="empdept" placeholder="Enter Employee Department"></input>
<br><br>

<input type="submit" value="Add"></input>

</form>
